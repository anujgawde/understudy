# Copy to .env and fill in what you need. .env is gitignored; this file is not.
#
# Nothing here is required to run a replay. Replay never calls a model, so the
# whole error taxonomy can be walked with none of these set:
#
#   npm run target-app
#   npm run replay packages/schemas/examples/lookup-savings-balance.capability.json -- \
#     --input memberNumber=12345 --input operatorUserId=tester --input operatorPassword=anything

# --- Discovery needs one of these -------------------------------------------
# Gemini is the default provider. Ollama needs no key and runs locally.
GEMINI_API_KEY=
# OLLAMA_HOST=http://localhost:11434

# --- Ports ------------------------------------------------------------------
# TARGET_APP_PORT=4000
# SERVER_PORT=4001

# --- Server mode (optional) --------------------------------------------------
# Both halves are opt-in and independent. Set neither and everything works
# standalone: the CLI writes to evidence/ and the console reads that folder.
#
# UNDERSTUDY_SERVER_URL tells the CLI to also POST its runs, capabilities,
# policies and interventions to a running server. A failure to reach it is
# reported loudly and does not fail the run — the evidence is already on disk.
# UNDERSTUDY_SERVER_URL=http://localhost:4001
#
# NEXT_PUBLIC_API_URL tells the console to read from that server instead of
# from evidence/. Set it when you want the console to show what the server
# holds rather than what is on this machine's disk.
# NEXT_PUBLIC_API_URL=http://localhost:4001
#
# DATA_DIR=apps/server/data   # where the server persists what it is sent
# EVIDENCE_DIR=evidence       # where the console reads from in standalone mode
