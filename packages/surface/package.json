{
  "name": "@understudy/surface",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Surface abstraction — observe, act, and resolve against a browser page via Playwright.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@understudy/schemas": "*",
    "playwright": "^1.52.0"
  }
}
