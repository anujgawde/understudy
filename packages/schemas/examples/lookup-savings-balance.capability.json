{
  "capabilityId": "lookup-savings-balance",
  "name": "Look up member savings balance",
  "version": 1,
  "goal": "Look up a member by number and read their current savings balance",
  "status": "draft",
  "inputs": [
    {
      "name": "memberNumber",
      "valueType": "string",
      "required": true,
      "description": "Member number as printed on the card"
    },
    {
      "name": "operatorUserId",
      "valueType": "string",
      "required": true,
      "description": "Teller sign-on user id"
    },
    {
      "name": "operatorPassword",
      "valueType": "string",
      "required": true,
      "description": "Teller sign-on password",
      "secret": true
    }
  ],
  "outputs": [
    { "name": "memberName", "valueType": "string", "required": true },
    { "name": "savingsBalance", "valueType": "number", "required": true }
  ],
  "steps": [
    {
      "stepId": "open-login",
      "description": "Land on the login page",
      "action": { "actionType": "navigate", "url": "http://localhost:4000/login" },
      "waitFor": { "waitUntil": "pageLoad" }
    },
    {
      "stepId": "fill-username",
      "action": {
        "actionType": "fill",
        "target": [
          { "strategy": "role", "role": "textbox", "accessibleName": "User ID" },
          { "strategy": "adjacent", "labelText": "User ID", "direction": "next", "targetRole": "textbox" }
        ],
        "value": "{{operatorUserId}}"
      }
    },
    {
      "stepId": "fill-password",
      "action": {
        "actionType": "fill",
        "target": [
          { "strategy": "adjacent", "labelText": "Password", "direction": "next", "targetRole": "textbox" },
          { "strategy": "css", "selector": "#ctl00_ContentMain_txtPassword" }
        ],
        "value": "{{operatorPassword}}"
      }
    },
    {
      "stepId": "submit-login",
      "action": {
        "actionType": "click",
        "target": [{ "strategy": "role", "role": "button", "accessibleName": "Sign In" }]
      },
      "waitFor": { "waitUntil": "textPresent", "text": "Member Search" }
    },
    {
      "stepId": "fill-member-number",
      "action": {
        "actionType": "fill",
        "target": [
          { "strategy": "adjacent", "labelText": "Member No", "direction": "next", "targetRole": "textbox" },
          { "strategy": "css", "selector": "#ctl00_ContentMain_txtMbrNo" }
        ],
        "value": "{{memberNumber}}"
      }
    },
    {
      "stepId": "submit-search",
      "action": {
        "actionType": "click",
        "target": [{ "strategy": "role", "role": "button", "accessibleName": "Search" }]
      },
      "waitFor": { "waitUntil": "textPresent", "text": "Search Results" }
    },
    {
      "stepId": "open-member-detail",
      "description": "The results grid posts a form rather than linking, so this must be a click. The row is addressed by position because the only value that identifies it is the member number, and replay substitutes inputs into actions, not into locators",
      "action": {
        "actionType": "click",
        "target": [
          {
            "strategy": "css",
            "selector": "#ctl00_ContentMain_grdResults tbody tr td:nth-child(2) a",
            "matchIndex": 0
          },
          { "strategy": "css", "selector": ".ctl00_Grid tbody a", "matchIndex": 0 }
        ]
      },
      "waitFor": { "waitUntil": "textPresent", "text": "Share Summary" }
    }
  ],
  "checkpoints": [
    {
      "checkpointId": "reached-search",
      "afterStepId": "submit-login",
      "allOf": [
        { "assert": "text_present", "text": "Member Search" },
        { "assert": "text_absent", "text": "Invalid user id or password" }
      ]
    },
    {
      "checkpointId": "reached-member-detail",
      "afterStepId": "open-member-detail",
      "allOf": [
        { "assert": "text_present", "text": "Share Summary" },
        {
          "assert": "element_present",
          "target": [{ "strategy": "text", "text": "Regular Share Savings" }]
        }
      ]
    }
  ],
  "extractions": [
    {
      "outputName": "memberName",
      "target": [
        { "strategy": "adjacent", "labelText": "Name", "direction": "next" },
        { "strategy": "css", "selector": ".ctl00_MemberInfo tr:nth-child(1) td:nth-child(4)" }
      ],
      "valueType": "string"
    },
    {
      "outputName": "savingsBalance",
      "target": [
        { "strategy": "adjacent", "labelText": "Regular Share Savings", "direction": "next" },
        { "strategy": "css", "selector": "#ctl00_ContentMain_grdShares tbody tr:nth-child(1) td:nth-child(3)" }
      ],
      "valueType": "number"
    }
  ]
}
